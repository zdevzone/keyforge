{
  "name": "keyforge",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hostable product-key server: signed offline license tokens, activation seats, install census, and an admin console.",
  "keywords": [
    "ed25519",
    "fastify",
    "license",
    "license-server",
    "licensing",
    "product-key",
    "self-hosted"
  ],
  "homepage": "https://github.com/zdevzone/keyforge#readme",
  "bugs": {
    "url": "https://github.com/zdevzone/keyforge/issues"
  },
  "license": "MIT",
  "author": "Abraham Bekele <keyforge@zdevzone.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zdevzone/keyforge.git"
  },
  "type": "module",
  "scripts": {
    "secrets:init": "node -- scripts/init-secrets.mjs",
    "secrets:export": "node -- scripts/export-secrets.mjs",
    "license": "node --env-file-if-exists=.env.local -- scripts/license-tool.mjs",
    "db": "node --env-file-if-exists=.env.local scripts/db-tool.mjs",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.mjs",
    "build": "tsc -p tsconfig.json && vp -C packages/keyforge-client run build && node scripts/runtime-package.mjs",
    "build:ui": "vp -C ui run build",
    "build:all": "vp run build && vp -C ui run build",
    "dev:ui": "vp -C ui dev",
    "start": "node --env-file-if-exists=.env.local dist/src/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && vp -C packages/keyforge-client run typecheck",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "check": "vp lint && vp fmt --check && vp run typecheck && vp -C ui run typecheck",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "test:postgres": "tsx --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "backup:restore": "node --env-file-if-exists=.env.local scripts/restore-backup.mjs",
    "test:console": "node scripts/console-smoke.mjs",
    "test:issuance": "node scripts/issuance-smoke.mjs",
    "test:docs": "node scripts/docs-smoke.mjs",
    "test:packages": "node scripts/package-smoke.mjs",
    "docs:api": "node scripts/generate-api-docs.mjs",
    "docs:client-api": "tsx scripts/generate-client-openapi.ts",
    "db:reset": "node --env-file-if-exists=.env.local scripts/reset-database.mjs",
    "data:clean": "node --env-file-if-exists=.env.local scripts/cleanup-data.mjs",
    "demo:seed": "node --env-file-if-exists=.env.local scripts/demo-seed.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/reset-database.mjs --demo --clean-local",
    "storage:init": "node --env-file-if-exists=.env.local scripts/storage-init.mjs",
    "test:features": "node --env-file-if-exists=.env.local scripts/test-features.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@t3-oss/env-core": "^0.13.11",
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.1",
    "better-auth": "^1.7.7",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.5",
    "kysely": "^0.29.6",
    "pg": "^8.23.1",
    "uploadthing": "^7.7.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "playwright": "^1.64.0",
    "smol-toml": "^1.9.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite-plus": "catalog:",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "effect": "3.22.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.2",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || ^26.0.0"
  },
  "packageManager": "pnpm@12.11.2"
}
