{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "const": "default"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "kind": {
      "type": "string",
      "const": "trial"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "verdict": {
      "type": "string",
      "enum": [
        "fresh",
        "spent"
      ]
    },
    "allowance": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "supportReference": {
      "type": [
        "string",
        "null"
      ]
    },
    "converted": {
      "type": "boolean"
    }
  },
  "required": [
    "iss",
    "productId",
    "kid",
    "installationId",
    "issuedAt",
    "expiresAt",
    "kind",
    "v",
    "verdict",
    "allowance",
    "supportReference",
    "converted"
  ],
  "additionalProperties": false
}
