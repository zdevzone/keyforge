{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iss": {
      "type": "string",
      "const": "default"
    },
    "productId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "kid": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "installationId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "v": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "usage-recovery"
    },
    "recoveryId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "accountId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "challenge": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "mode": {
      "type": "string",
      "enum": [
        "restore",
        "lost_history"
      ]
    },
    "usageDigest": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "paidImportsFloor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "trialImportsFloor": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "recoveryGeneration": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "authorizationRevision": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "iss",
    "productId",
    "kid",
    "installationId",
    "issuedAt",
    "expiresAt",
    "v",
    "kind",
    "recoveryId",
    "accountId",
    "challenge",
    "mode",
    "usageDigest",
    "paidImportsFloor",
    "trialImportsFloor",
    "recoveryGeneration",
    "authorizationRevision"
  ],
  "additionalProperties": false
}
