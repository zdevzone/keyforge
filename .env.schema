# Keyforge local environment. Run `vp run secrets:init --yes` before `vp run env:check`.
# @defaultRequired=false

# @sensitive @required
LICENSE_SIGNING_KEY=

# @sensitive
LICENSE_DATA_KEYRING_FILE=

# @sensitive
LICENSE_BACKUP_KEYRING_FILE=

# @sensitive
LICENSE_ADMIN_TOKEN=

# @sensitive
LICENSE_AUTH_SECRET=

# @sensitive
CRON_SECRET=

# @sensitive
DATABASE_URL=

# Docker-only URL. Use postgres:5432, not the host-facing port.
# @sensitive
COMPOSE_DATABASE_URL=

LICENSE_DB_PATH=

# @type=number
LICENSE_PORT=4100

# @type=number
POSTGRES_PORT=55433

# Docker Compose defaults to keyforge when unset.
POSTGRES_DB=keyforge

# Docker Compose defaults to keyforge when unset; set a unique value for deployments.
# @sensitive
POSTGRES_PASSWORD=

LICENSE_SERVER_URL=http://localhost:4100/

# Optional boot-time administrator.
LICENSE_SEED_ADMIN_EMAIL=

# @sensitive
LICENSE_SEED_ADMIN_PASSWORD=
