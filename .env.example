# Every variable here is validated at boot (src/env.ts). An unset variable is
# fine — it means the documented default. A malformed one stops the service
# with a message naming it, rather than becoming a silent wrong default.
#
# License service (vendor side, `vp run start`). The signing
# key is the trust root: its public half is embedded in the app, its private
# half exists only here. Generate with `vp run license keygen`.
LICENSE_SIGNING_KEY_FILE=./license/license-signing.key
# Alternative to the file above; never set both:
# LICENSE_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\nYour Key Here\n-----END PRIVATE KEY-----\n"
# Optional: the name tokens carry in their `kid`, so an app holding several
# public keys knows which one to verify with. Unset derives one from the key's
# fingerprint. Set it when you rotate on a schedule and want readable ids.
# LICENSE_SIGNING_KID=2026-08
LICENSE_SERVER_URL="http://localhost:4100/"
LICENSE_ADMIN_TOKEN="<long random string; gates the vendor tool's admin API>"
LICENSE_PORT=4100
LICENSE_DB_PATH=./db/licenses.sqlite

# Optional: run the ledger (and operator accounts) on Postgres instead of
# SQLite. Migrations run at boot either way.
# DATABASE_URL=postgres://user:password@localhost:5432/keyforge

# Admin console (web UI). Unset = console disabled; the CLI keeps working.
# Create operators with: vp run admin:create --email ... --password ...
LICENSE_AUTH_SECRET="<long random string; signs the console's session cookies>"

# Separate encryption keys for stored product/private keys and backup archives.
# Generate files with: vp run secrets:init
LICENSE_DATA_KEYRING_FILE=./secrets/data.keyring.json
LICENSE_BACKUP_KEYRING_FILE=./secrets/backup.keyring.json
# LICENSE_BACKUP_DIR=./backups
# LICENSE_BACKUP_S3_BUCKET=your-private-bucket
# LICENSE_BACKUP_S3_REGION=us-east-1
# LICENSE_BACKUP_S3_ENDPOINT=https://your-s3-compatible-service.example.com
# Optional dedicated S3 credentials; otherwise use the AWS SDK credential chain.
# LICENSE_BACKUP_S3_ACCESS_KEY_ID=...
# LICENSE_BACKUP_S3_SECRET_ACCESS_KEY=...
# LICENSE_BACKUP_S3_SESSION_TOKEN=... # only for temporary credentials
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
#
# R2 uses its own S3 API keys independently of AWS credentials:
# LICENSE_BACKUP_R2_BUCKET=your-private-bucket
# LICENSE_BACKUP_R2_ACCOUNT_ID=your-account-id
# Or an explicit endpoint instead of account ID:
# LICENSE_BACKUP_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# LICENSE_BACKUP_R2_ACCESS_KEY_ID=...
# LICENSE_BACKUP_R2_SECRET_ACCESS_KEY=...
# LICENSE_BACKUP_R2_SESSION_TOKEN=... # optional temporary credentials
#
# UploadThing current app token (UPLOADTHING_TOKEN is also accepted):
# LICENSE_BACKUP_UPLOADTHING_TOKEN=...
#
# Custom URLs are managed in the admin console. Authorization is optional.
# Reference a dedicated variable in the endpoint form; include the whole header:
# LICENSE_BACKUP_CUSTOM_BOX_TOKEN="Bearer ..."
# See docs/backups.md for schedules, formats and credential aliases.
# Postgres restore verification requires a separate scratch database administrator:
# LICENSE_BACKUP_VERIFY_DATABASE_URL=postgres://user:password@host/verification

# Optional boot-time operator seeding — for hosts without shell access, or
# hosts that wipe their disk on deploy (Render free tier). Idempotent: an
# existing user and their password are never touched.
# LICENSE_SEED_ADMIN_EMAIL=you@example.com
# LICENSE_SEED_ADMIN_PASSWORD="<long secret>"


