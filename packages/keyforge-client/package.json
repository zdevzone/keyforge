{
  "name": "@zdevzone/keyforge-client",
  "version": "0.1.1",
  "description": "Typed KeyForge installation client and signed offline authorization verifier",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zdevzone/keyforge.git",
    "directory": "packages/keyforge-client"
  },
  "files": [
    "dist",
    "README.md",
    "skill"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./windows": {
      "types": "./dist/windows.d.ts",
      "import": "./dist/windows.js"
    },
    "./linux": {
      "types": "./dist/linux.d.ts",
      "import": "./dist/linux.js"
    },
    "./macos": {
      "types": "./dist/macos.d.ts",
      "import": "./dist/macos.js"
    },
    "./device-signals": {
      "types": "./dist/device-signals.d.ts",
      "import": "./dist/device-signals.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node scripts/prepack.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
